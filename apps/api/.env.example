# === MongoDB (Atlas en dev, configurable en prod) ===
PJVPIN_MONGODB_URI=
PJVPIN_MONGODB_DB=pjvpin
PJVPIN_RUN_ENSURE_INDEXES=false

# === JWT ===
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access TTL (default 15m)
JWT_ACCESS_TTL=15m
# Refresh TTL (default 7d)
JWT_REFRESH_TTL=7d

# === HTTP server ===
PORT=3000

# === CORS (origenes separados por coma) ===
CORS_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

# === Auditoria (ruta del JSONL; ruta absoluta recomendada en contenedor) ===
PJVPIN_AUDIT_LOG_PATH=

# === RENIEC (usado solo por /auth/bootstrap/reniec-dni; el resto del flujo RENIEC vivirá en el módulo investigadores) ===
PJVPIN_RENIEC_TOKEN=
PJVPIN_RENIEC_API_BASE_URL=https://api.decolecta.com/v1

# === Ambiente ===
NODE_ENV=development