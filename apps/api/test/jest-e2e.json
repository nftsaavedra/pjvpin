{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "^.+\\.js$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": {
            "syntax": "ecmascript",
            "dynamicImport": true,
            "importMeta": true
          },
          "target": "es2022"
        },
        "module": {
          "type": "commonjs"
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1",
    "^@pjvpin/shared$": "<rootDir>/../../../packages/shared/dist/index.js",
    "^@nestjs/event-emitter$": "<rootDir>/__mocks__/event-emitter.ts",
    "^@nestjs/websockets$": "<rootDir>/__mocks__/websockets.ts",
    "^@nestjs/platform-socket.io$": "<rootDir>/__mocks__/platform-socket.io.ts",
    "^socket\\.io$": "<rootDir>/__mocks__/socket.io.ts"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(\\.pnpm/[^/]+/node_modules/)?@nestjs/)"
  ],
  "testEnvironment": "node"
}
